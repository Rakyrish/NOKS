####################################################################
#  NOKS — CHEMICAL DIVISION  ·  LOCAL DEVELOPMENT TEMPLATE
#  Single source of truth for the whole stack (Django + Next.js).
#  Read by backend/config/settings.py (load_dotenv) and frontend/next.config.ts.
#
#  Copy this file to `.env` at the repo root, then fill in real values for
#  anything you need locally. Nothing here is a real secret — production
#  values live only in the deployed environment's own `.env`, never in git.
####################################################################

# ─────────────────────────────── ENVIRONMENT ──────────────────────
DJANGO_ENV=development
DJANGO_DEBUG=True
# Leave blank locally to use settings.py's insecure dev fallback; set a real
# random value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
# before deploying anywhere reachable from the internet.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Africa/Nairobi
DJANGO_LANGUAGE_CODE=en-ke

# Keep False for local http development; the deployed .env sets this True
# once TLS is terminated in front of the app (see nginx/nginx.conf comments).
DJANGO_SECURE_SSL_REDIRECT=False

# ─────────────────────────────── DATABASE ─────────────────────────
# Leave DATABASE_URL blank to fall back to a zero-config SQLite file.
# Or run the Postgres container from README.md "Quick start" and use:
#   DATABASE_URL=postgres://noks:noks@localhost:5440/noks
DATABASE_URL=
POSTGRES_DB=noks
POSTGRES_USER=noks
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─────────────────────────────── CACHE / QUEUE ────────────────────
# Leave blank to run without Redis: cache falls back to LocMemCache and
# Celery tasks run inline (CELERY_TASK_ALWAYS_EAGER).
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ─────────────────────────────── URLS / PORTS ─────────────────────
SITE_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Server-side rendering calls this over the Docker network, never the public URL.
INTERNAL_API_URL=http://localhost:8000/api/v1
BACKEND_PORT=8000
# MUST be 3000: scripts/next-with-env.mjs binds Next to FRONTEND_PORT, and the
# nginx upstream (if you run the compose stack) is frontend:3000.
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────── BRAND IDENTITY ───────────────────
NEXT_PUBLIC_BRAND_NAME=NOKS
NEXT_PUBLIC_BRAND_DIVISION=Chemical Division
NEXT_PUBLIC_BRAND_TAGLINE=Industrial Chemicals • Laboratory Reagents • Water Treatment • Food Grade Solutions
NEXT_PUBLIC_BRAND_MISSION=Deliver premium industrial and laboratory chemicals through quality products, technical expertise, and reliable supply across Kenya and East Africa.
NEXT_PUBLIC_BRAND_LOGO=/noks-logo.jpeg

NEXT_PUBLIC_COLOR_PRIMARY="#0C48E6"
NEXT_PUBLIC_COLOR_PRIMARY_DARK="#0A38C2"
NEXT_PUBLIC_COLOR_NAVY="#071233"
NEXT_PUBLIC_COLOR_NAVY_SOFT="#0E1E45"
NEXT_PUBLIC_COLOR_EMERALD="#059669"
NEXT_PUBLIC_COLOR_EMERALD_LIGHT="#10B981"
NEXT_PUBLIC_COLOR_ACCENT="#2F5EFA"
NEXT_PUBLIC_COLOR_SURFACE="#FFFFFF"
NEXT_PUBLIC_COLOR_MUTED="#F5F7FB"
NEXT_PUBLIC_FONT_SANS=Inter
NEXT_PUBLIC_FONT_DISPLAY=Sora

# ─────────────────────────────── CONTACT / SOCIAL ─────────────────
NEXT_PUBLIC_CONTACT_EMAIL=sales@example.com
NEXT_PUBLIC_CONTACT_EMAIL_SUPPORT=technical@example.com
NEXT_PUBLIC_CONTACT_PHONE=+254 700 000 000
NEXT_PUBLIC_CONTACT_PHONE_ALT=
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000
NEXT_PUBLIC_ADDRESS_STREET=Enterprise Road, Industrial Area
NEXT_PUBLIC_ADDRESS_CITY=Nairobi
NEXT_PUBLIC_ADDRESS_COUNTRY=Kenya
NEXT_PUBLIC_ADDRESS_POSTAL=00100
NEXT_PUBLIC_GEO_LAT=-1.3084
NEXT_PUBLIC_GEO_LNG=36.8515
NEXT_PUBLIC_OPENING_HOURS=Mo-Fr 08:00-17:30, Sa 08:00-13:00
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=

# ─────────────────────────────── COMPANY STATS ────────────────────
# Rendered on the homepage stats band only until real `Stat` rows exist in
# the CMS (see apps.core.models.Stat) — see components/home/stats-band.tsx.
NEXT_PUBLIC_STAT_YEARS=15
NEXT_PUBLIC_STAT_PRODUCTS=1200
NEXT_PUBLIC_STAT_COUNTRIES=8
NEXT_PUBLIC_STAT_INDUSTRIES=12
NEXT_PUBLIC_STAT_DELIVERIES=25000
NEXT_PUBLIC_STAT_SATISFACTION=98

# ─────────────────────────────── SEO ──────────────────────────────
NEXT_PUBLIC_SEO_TITLE=NOKS Chemical Division — Industrial Chemicals Supplier in Kenya
NEXT_PUBLIC_SEO_DESCRIPTION=NOKS Chemical Division supplies certified industrial chemicals, laboratory reagents, water treatment solutions and food grade ingredients across Kenya and East Africa.
NEXT_PUBLIC_SEO_KEYWORDS=industrial chemicals Kenya,laboratory reagents Nairobi,water treatment chemicals East Africa,food grade chemicals,chemical supplier Kenya
NEXT_PUBLIC_SEO_LOCALE=en_KE
NEXT_PUBLIC_SEO_TWITTER_HANDLE=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED=

# ─────────────────────────────── AI ASSISTANT (customer-facing) ───
# Empty key ⇒ settings.AI_ENABLED is False and the assistant endpoint is inert,
# even though NEXT_PUBLIC_AI_ENABLED renders the widget. Fill in to activate.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.3
AI_ASSISTANT_NAME=NOKS Chem Assistant
NEXT_PUBLIC_AI_ASSISTANT_NAME=NOKS Chem Assistant
NEXT_PUBLIC_AI_ENABLED=True

# ─────────────────────────────── AI PRODUCT DRAFTING (admin-only) ─
# Separate OpenAI key powering the "Generate with AI" button in /admin/products.
# Empty ⇒ settings.AI_PRODUCT_DRAFTING_ENABLED is False and the control panel
# shows "AI drafting not configured" instead of the generate button. It never
# drafts hazard/GHS/UN-number/storage data — see backend/apps/catalog/ai.py.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────── EMAIL ────────────────────────────
# Console backend = quotation notifications are only logged, never delivered.
# Switch to smtp + fill EMAIL_HOST_USER/PASSWORD to actually send.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=NOKS Chemical Division <no-reply@example.com>
SALES_NOTIFICATION_EMAIL=sales@example.com

# ─────────────────────────────── MEDIA / CLOUDINARY ───────────────
# False (default) ⇒ every ImageField/FileField uses local disk storage
# (backend/media/, served by nginx from the shared `media` volume). Set True
# and fill in the three values below to switch image fields to Cloudinary —
# ProductDocument.file and MediaAsset.file stay on local storage either way
# (see their models).
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_IMAGE_DOMAINS=localhost,res.cloudinary.com,images.unsplash.com

# ─────────────────────────────── ADMIN ────────────────────────────
DJANGO_ADMIN_URL=django-admin/
DJANGO_ADMIN_SITE_HEADER=NOKS Chemical Division
DJANGO_ADMIN_SITE_TITLE=NOKS Control Centre
DJANGO_ADMIN_INDEX_TITLE=Operations Dashboard
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# ─────────────────────────────── RATE LIMITING ────────────────────
THROTTLE_ANON_RATE=120/hour
THROTTLE_USER_RATE=1000/hour
THROTTLE_AI_RATE=30/hour
THROTTLE_LOGIN_RATE=20/hour
